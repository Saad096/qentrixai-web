# ---------------------------------------------------------------------------
# QentrixAI website — environment variables
# Copy this file to `.env.local` for local dev and `.env` for Docker.
# Public values use the NEXT_PUBLIC_ prefix and are inlined at build time.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://www.qentrix-ai.com
NEXT_PUBLIC_SITE_NAME=QentrixAI

# Profile (used across UI for contact/credibility)
NEXT_PUBLIC_PROFILE_NAME=Saad Alam
NEXT_PUBLIC_PROFILE_ROLE=AI & Data Science Consultant | GenAI & Agentic AI Specialist
NEXT_PUBLIC_PROFILE_TAGLINE=AI systems that make it to production
NEXT_PUBLIC_PROFILE_EMAIL=talk@qentrix-ai.com
NEXT_PUBLIC_PROFILE_PHONE=+923196828506
NEXT_PUBLIC_PROFILE_LOCATION=Lahore, Pakistan
NEXT_PUBLIC_PROFILE_AVAILABILITY=Open for Projects, Ideas & Remote Positions
NEXT_PUBLIC_PROFILE_RESUME_URL=/api/resume

# Socials
NEXT_PUBLIC_PROFILE_LINKEDIN=https://www.linkedin.com/company/qentrixai
NEXT_PUBLIC_PROFILE_GITHUB=https://github.com/Saad096
NEXT_PUBLIC_PROFILE_WHATSAPP=https://wa.me/923196828506
NEXT_PUBLIC_PROFILE_INSTAGRAM=https://www.instagram.com/qentrixai/
NEXT_PUBLIC_PROFILE_FACEBOOK=https://www.facebook.com/Qentrixai

# Team LinkedIn URLs (leave blank to hide the LinkedIn button per member)
NEXT_PUBLIC_TEAM_SHAHID_LINKEDIN=
NEXT_PUBLIC_TEAM_SAAD_LINKEDIN=https://www.linkedin.com/in/saad-alam-b9a304217/
NEXT_PUBLIC_TEAM_SHAFAAT_LINKEDIN=
NEXT_PUBLIC_TEAM_MAWRA_LINKEDIN=

# Booking is handled in-house at /book (see src/lib/booking.ts) — no external
# calendar URL needed.

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Contact form / email (server-only)
# Pick ONE provider for EMAIL_PROVIDER: smtp | resend | sendgrid
# If unset, the contact form degrades gracefully to a "we got it, please email
# or WhatsApp us" message.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
CONTACT_RECEIVER_EMAIL=talk2saadalam@gmail.com

# Resend (recommended — 3,000 emails/month free, no card required)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Default sender — onboarding@resend.dev works without verification but only
# delivers to the email tied to your Resend account. Once you verify a domain
# at https://resend.com/domains, set this to e.g. noreply@qentrixai.com.
RESEND_FROM_EMAIL=noreply@send.qentrix-ai.com
RESEND_FROM_NAME=QentrixAI

# SMTP (alternative — e.g. Gmail App Password, AWS SES, Mailgun SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SendGrid (alternative)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=QentrixAI

# Resume file override (filename inside /public/resume/)
# RESUME_FILENAME=Saad_Alam_Resume.pdf

# CORS
CORS_ALLOW_ORIGINS=*

# Calendly event used by the in-page booking dialog.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/talk2saad/30-min-growth-strategy-call
