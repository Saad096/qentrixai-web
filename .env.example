# ═══════════════════════════════════════════════════════════════════════
# QentrixAI — environment
#
# Copy to .env.local for local work. On Vercel, add these under
# Settings → Environment Variables. Anything gitignored (.env, .env.local)
# is NOT deployed, so a value that only lives there will be missing in
# production — that is the usual cause of "it worked locally".
#
# REQUIRED IN PRODUCTION is marked per block. Everything else has a working
# default in src/lib/env.ts and can be left unset.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time. Never put
# a secret behind that prefix. Changing one needs a redeploy, not a restart.
# ═══════════════════════════════════════════════════════════════════════


# ── Site identity ──────────────────────────────────────── REQUIRED ─────
# The canonical origin. The apex 308-redirects to www, so this must be the
# www host or every canonical URL, og:url and sitemap entry points at a
# redirect. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.qentrix-ai.com
NEXT_PUBLIC_SITE_NAME=QentrixAI


# ── Contact details shown on the site ───────────────────────────────────
# Public-facing. This is the address a visitor writes to by hand; it is NOT
# where the contact form delivers (see CONTACT_RECEIVER_EMAIL below).
NEXT_PUBLIC_PROFILE_EMAIL=talk@qentrix-ai.com
NEXT_PUBLIC_PROFILE_PHONE=+923196828506
NEXT_PUBLIC_PROFILE_WHATSAPP=
NEXT_PUBLIC_PROFILE_NAME=Saad Alam
NEXT_PUBLIC_PROFILE_ROLE=AI & Data Science Consultant | GenAI & Agentic AI Specialist
NEXT_PUBLIC_PROFILE_TAGLINE=AI systems that make it to production
NEXT_PUBLIC_PROFILE_LOCATION=Wilmington, Delaware and Lahore, Pakistan
NEXT_PUBLIC_PROFILE_AVAILABILITY=Open for Projects, Ideas & Remote Positions


# ── Social accounts ─────────────────────────────────────────────────────
# Company accounts, not personal ones. Leaving one blank hides its icon.
NEXT_PUBLIC_PROFILE_LINKEDIN=https://www.linkedin.com/company/qentrixai
NEXT_PUBLIC_PROFILE_GITHUB=https://github.com/Saad096
NEXT_PUBLIC_PROFILE_INSTAGRAM=https://www.instagram.com/qentrixai/
NEXT_PUBLIC_PROFILE_FACEBOOK=https://www.facebook.com/Qentrixai


# ── Team LinkedIn profiles ──────────────────────────────────────────────
NEXT_PUBLIC_TEAM_SAAD_LINKEDIN=
NEXT_PUBLIC_TEAM_SHAHID_LINKEDIN=
NEXT_PUBLIC_TEAM_SHAFAAT_LINKEDIN=
NEXT_PUBLIC_TEAM_MAWRA_LINKEDIN=


# ── Booking ─────────────────────────────────────────────────────────────
# The event the in-page booking dialog embeds. /book stays a real route for
# no-JS and for direct links; the dialog is the enhancement.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/talk2saad/30-min-growth-strategy-call


# ── Contact form delivery ───────────────────────────── REQUIRED ────────
# Where a submitted brief lands. Deliberately separate from the address
# displayed on the site above.
CONTACT_RECEIVER_EMAIL=talk2saadalam@gmail.com

# One of: resend | sendgrid | smtp
EMAIL_PROVIDER=resend

# Resend (the configured provider).
#   1. Verify the sending domain at https://resend.com/domains
#   2. Create a key at https://resend.com/api-keys
# The FROM domain must be a verified one or every send is refused. The form
# reports that honestly rather than showing a false success.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@send.qentrix-ai.com
RESEND_FROM_NAME=QentrixAI

# SendGrid — only if EMAIL_PROVIDER=sendgrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=QentrixAI

# SMTP — only if EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=


# ── API access ──────────────────────────────────────────────────────────
# Origins allowed to POST /api/contact. Leave unset for same-origin only;
# "*" opens it to every site, which is rarely what you want in production.
CORS_ALLOW_ORIGINS=


# ── Analytics (optional) ────────────────────────────────────────────────
# Both are off unless set. Consent behaviour must match the privacy page.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=


# ── Downloads (optional) ────────────────────────────────────────────────
# /api/resume serves a PDF from public/resume. That folder is empty, so the
# route currently 404s by design. Drop a PDF in and name it here, or leave
# both unset.
RESUME_FILENAME=
NEXT_PUBLIC_PROFILE_RESUME_URL=/api/resume
